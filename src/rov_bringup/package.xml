<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files for the WATonomous ROV simulation and control stack.</description>
  <maintainer email="bmacraze@gmail.com">bmacraze</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rov_description</exec_depend>
  <exec_depend>rov_gazebo</exec_depend>
  <exec_depend>rov_control</exec_depend>
  <exec_depend>rov_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
