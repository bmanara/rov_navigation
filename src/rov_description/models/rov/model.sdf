<?xml version="1.0"?>
<!--
  WATonomous ROV, Gazebo Harmonic model.

  Geometry/limits of the thrusters MUST match config/thrusters.yaml
  (checked by test/test_model_consistency.py).

  Buoyancy: the Buoyancy world system computes displaced volume from the
  COLLISION geometry. The collision box below is sized so that
  displaced mass = 11.60 kg vs. total mass = 11.40 kg (base 11.0 + 8 x 0.05),
  i.e. ~+1.96 N net buoyancy (slightly positive). The box is centred 4 cm above
  the CoM, so the centre of buoyancy sits above the centre of mass and the
  vehicle is passively stable in roll/pitch.

  Hydrodynamic coefficients are PLACEHOLDERS taken from published BlueROV2
  Heavy identification (von Benzon et al., 2022). Tune them against the real
  vehicle (CLAUDE.md milestone 6).
-->
<sdf version="1.11">
  <model name="rov">
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>11.0</mass>
        <inertia>
          <ixx>0.1696</ixx><iyy>0.2429</iyy><izz>0.2979</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
        <!-- Added mass (PLACEHOLDER, BlueROV2 Heavy literature values).
             Equivalent to Hydrodynamics xDotU=-5.5, yDotV=-12.7, zDotW=-14.57,
             kDotP=mDotQ=nDotR=-0.12 (sign flipped: this block is positive). -->
        <fluid_added_mass>
          <xx>5.5</xx><xy>0</xy><xz>0</xz><xp>0</xp><xq>0</xq><xr>0</xr>
          <yy>12.7</yy><yz>0</yz><yp>0</yp><yq>0</yq><yr>0</yr>
          <zz>14.57</zz><zp>0</zp><zq>0</zq><zr>0</zr>
          <pp>0.12</pp><pq>0</pq><pr>0</pr>
          <qq>0.12</qq><qr>0</qr>
          <rr>0.12</rr>
        </fluid_added_mass>
      </inertial>

      <!-- Buoyancy + contact volume: 0.40 x 0.29 x 0.10 = 0.0116 m^3 -->
      <collision name="hull_collision">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><box><size>0.40 0.29 0.10</size></box></geometry>
      </collision>

      <!-- Visuals: frame + buoyancy block + electronics tube -->
      <visual name="frame_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.44 0.30 0.02</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="float_visual">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry><box><size>0.40 0.29 0.06</size></box></geometry>
        <material><ambient>0.0 0.2 0.6 1</ambient><diffuse>0.0 0.3 0.9 1</diffuse></material>
      </visual>
      <visual name="tube_visual">
        <pose>0 0 -0.05 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.40</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
      </visual>

      <!-- IMU: co-located with base_link (imu_link in the URDF) -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/rov/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Forward camera. Pose must match camera_link in urdf/rov.urdf -->
      <sensor name="front_camera" type="camera">
        <pose>0.22 0 0.0 0 0 0</pose>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>/rov/camera/image</topic>
        <camera>
          <camera_info_topic>/rov/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.40</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>

    <link name="thruster1">
      <pose>0.15 -0.11 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 1.570796 0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster1</child>
      <axis>
        <xyz>0.70710678 0.70710678 0.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster2">
      <pose>0.15 0.11 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 1.570796 -0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster2</child>
      <axis>
        <xyz>0.70710678 -0.70710678 0.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster3">
      <pose>-0.15 -0.11 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 1.570796 -0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster3</child>
      <axis>
        <xyz>0.70710678 -0.70710678 0.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster4">
      <pose>-0.15 0.11 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 1.570796 0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster4</child>
      <axis>
        <xyz>0.70710678 0.70710678 0.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster5">
      <pose>0.12 -0.22 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0.000000 0.000000</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster5</child>
      <axis>
        <xyz>0.0 0.0 1.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster6">
      <pose>0.12 0.22 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0.000000 0.000000</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster6</child>
      <axis>
        <xyz>0.0 0.0 1.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster7">
      <pose>-0.12 -0.22 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0.000000 0.000000</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster7_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster7</child>
      <axis>
        <xyz>0.0 0.0 1.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <link name="thruster8">
      <pose>-0.12 0.22 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0.000000 0.000000</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="thruster8_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster8</child>
      <axis>
        <xyz>0.0 0.0 1.0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort><velocity>1e6</velocity></limit>
      </axis>
    </joint>
    <!-- One Thruster system per thruster joint; command topic:
         /model/rov/joint/thrusterN_joint/cmd_thrust (gz.msgs.Double, Newtons) -->

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster1_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster2_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster3_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster4_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster5_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster6_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster7_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>thruster8_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <use_angvel_cmd>false</use_angvel_cmd>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>40.0</max_thrust_cmd>
      <min_thrust_cmd>-30.0</min_thrust_cmd>
    </plugin>
    <!-- Hydrodynamics: added mass + linear/quadratic damping (PLACEHOLDERS) -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000</water_density>
      <!-- Added mass is NOT applied here: the plugin applies it as an explicit
           force, which goes unstable for a light vehicle like this one (sim
           blew up in testing). It is set via <fluid_added_mass> on base_link
           instead, which the physics engine handles implicitly. Keep these 0. -->
      <xDotU>0</xDotU>
      <yDotV>0</yDotV>
      <zDotW>0</zDotW>
      <kDotP>0</kDotP>
      <mDotQ>0</mDotQ>
      <nDotR>0</nDotR>
      <!-- linear damping -->
      <xU>-4.03</xU>
      <yV>-6.22</yV>
      <zW>-5.18</zW>
      <kP>-0.07</kP>
      <mQ>-0.07</mQ>
      <nR>-0.07</nR>
      <!-- quadratic damping -->
      <xUabsU>-18.18</xUabsU>
      <yVabsV>-21.66</yVabsV>
      <zWabsW>-36.99</zWabsW>
      <kPabsP>-1.55</kPabsP>
      <mQabsQ>-1.55</mQabsQ>
      <nRabsR>-1.55</nRabsR>
    </plugin>

    <!-- Ground truth odometry (bridged to /odometry/ground_truth).
         Twist is expressed in the body frame (base_link). -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/rov/odometry</odom_topic>
      <tf_topic>/model/rov/odometry_tf</tf_topic>
    </plugin>
  </model>
</sdf>
